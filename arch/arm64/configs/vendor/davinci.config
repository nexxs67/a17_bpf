# Compass
CONFIG_AKM09970=y

# Device
CONFIG_MACH_XIAOMI_DAVINCI=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_GOODIX_TA=y

# Ramoops
CONFIG_CMDLINE="cgroup_disable=pressure ramoops_memreserve=4M"

# SKU
CONFIG_CMDLINE_HWC_IS_PRODUCT_SKU=y

# Step motor
CONFIG_TI_DRV8846=y

# Touchscreen
CONFIG_TOUCHSCREEN_GOODIX_GTX8=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y
CONFIG_TOUCHSCREEN_TDDI_DBCLK=y

# CPU topology masks (SM6150 / SD730G: 6x Kryo470 Silver + 2x Kryo470 Gold).
# arch/arm64/Kconfig declares these as int with a prompt and NO default, so
# leaving them unset makes silentoldconfig prompt interactively and abort
# under CI ("Console input/output is redirected").
# 63  = 0b00111111 -> CPU0-5 (LITTLE)
# 192 = 0b11000000 -> CPU6-7 (big)
CONFIG_LITTLE_CPU_MASK=63
CONFIG_BIG_CPU_MASK=192

# zram writeback in this tree is 6.5+ code (BLK_OPEN_*, new bio_alloc/
# bio_init/blkdev_put signatures) that was never adapted to the 4.14 block
# API, so it cannot compile here. Plain zram is unaffected; writeback also
# needs a backing device configured via sysfs, which davinci does not use.
# CONFIG_ZRAM_WRITEBACK is not set
